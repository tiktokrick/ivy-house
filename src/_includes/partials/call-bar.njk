<div class="call-bar" role="region" aria-label="Quick contact">
  <a class="call-bar__link" href="{{ site.phone | telHref }}" data-event="phone_click">Call</a>
  {%- if callbackTopic == "implants" %}
  <a class="call-bar__link call-bar__link--accent call-bar__link--long" href="#callback">Implant consultation</a>
  {%- else %}
  <a class="call-bar__link call-bar__link--accent" href="{{ '#callback' if inlineCallback else '/contact/#callback' }}">Callback</a>
  {%- endif %}
</div>
