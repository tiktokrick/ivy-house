{% from "components/button.njk" import button %}
{% from "components/placeholder.njk" import placeholder %}
{#- Home hero: clinician photo with dark overlay text. -#}
{% macro hero(heading, subline, photoLabel, site) -%}
<section class="hero on-dark" aria-labelledby="hero-heading">
  <div class="hero__media">
    {{ placeholder(photoLabel, "3/2", "dark") }}
  </div>
  <div class="container hero__content">
    {%- if site.acceptingNewPatients %}
    <p class="hero__badge">{{ subline }}</p>
    {%- endif %}
    <h1 id="hero-heading" class="hero__heading">{{ heading }}</h1>
    <div class="hero__actions">
      {{ button("Request a callback", "/contact/#callback", "solid") }}
      <a class="button button--outline" href="{{ site.phone | telHref }}" data-event="phone_click">Call {{ site.phone | tbc | safe }}</a>
    </div>
  </div>
</section>
{%- endmacro %}
