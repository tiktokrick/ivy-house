---
layout: layouts/base.njk
---
{#- Home page, sections in the order set by BRIEF §6. Copy lives in content/index.md front matter. -#}
{% from "components/hero.njk" import hero %}
{% from "components/before-after.njk" import beforeAfter %}
{% from "components/problem-card.njk" import problemCard %}
{% from "components/heritage-band.njk" import heritageBand %}
{% from "components/clinician-card.njk" import clinicianCard %}
{% from "components/testimonial-card.njk" import testimonialCard %}
{% from "components/callback-form.njk" import callbackForm %}
{% from "components/practical-info.njk" import practicalInfo %}
{% from "components/placeholder.njk" import placeholder %}
{% from "components/feature-band.njk" import featureBand %}

{# 1. Hero #}
{{ hero(home.hero.heading, home.hero.subline, home.hero.photoLabel, site) }}

{# 2. Results strip #}
<section class="section section--paper" aria-labelledby="results-heading">
  <div class="container">
    <div class="section__head section__head--split">
      <div>
        <p class="eyebrow">{{ home.results.eyebrow }}</p>
        <h2 id="results-heading">{{ home.results.heading }}</h2>
      </div>
      <a href="/smile-gallery/">See the smile gallery</a>
    </div>
    {%- if collections.gallery.length %}
    <div class="grid grid--3">
      {%- for c in collections.gallery | head(3) %}{{ beforeAfter(c) }}{% endfor %}
    </div>
    {%- else %}
    {#- No consented cases yet: hold the layout with labelled placeholders. -#}
    <div class="grid grid--3">
      {%- for label in home.results.placeholders %}
      <div class="before-after before-after--pending">
        {{ placeholder(label, "2/1") }}
      </div>
      {%- endfor %}
    </div>
    {%- endif %}
  </div>
</section>

{# 3. How can we help? #}
<section class="section" aria-labelledby="help-heading">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">{{ home.help.eyebrow }}</p>
      <h2 id="help-heading">{{ home.help.heading }}</h2>
    </div>
    <div class="grid grid--3">
      {%- for card in home.help.cards %}{{ problemCard(card) }}{% endfor %}
    </div>
  </div>
</section>

{# 4. Implants, in Yusef's voice (BRIEF §6, v1.2) #}
{{ featureBand(home.implants, "dark", site) }}

{# 5. Older patients, written for the adult child (BRIEF §6, v1.3) #}
{{ featureBand(home.olderPatients, "light", site) }}

{# 6. Heritage #}
{{ heritageBand(home.heritage, site) }}

{# 7. Clinicians #}
<section class="section" aria-labelledby="team-heading">
  <div class="container">
    <div class="section__head section__head--split">
      <div>
        <p class="eyebrow">{{ home.team.eyebrow }}</p>
        <h2 id="team-heading">{{ home.team.heading }}</h2>
      </div>
      <a href="/team/">Meet the team</a>
    </div>
    <div class="grid grid--team">
      {%- for c in collections.clinicians %}{{ clinicianCard(c) }}{% endfor %}
    </div>
  </div>
</section>

{# 8. Testimonials #}
{%- if collections.testimonials.length %}
<section class="section section--paper" aria-labelledby="testimonials-heading">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">{{ home.testimonials.eyebrow }}</p>
      <h2 id="testimonials-heading">{{ home.testimonials.heading }}</h2>
    </div>
    <div class="grid grid--3">
      {%- for t in collections.testimonials | head(3) %}{{ testimonialCard(t) }}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

{# 9. Callback form + practical info #}
<section class="section on-dark contact-band" aria-labelledby="contact-heading">
  <div class="container split">
    <div>
      <p class="eyebrow">{{ home.contact.eyebrow }}</p>
      <h2 id="contact-heading">{{ home.contact.heading }}</h2>
      <p class="muted">{{ home.contact.text }}</p>
      {{ callbackForm(site, "callback", "", "", page.url) }}
    </div>
    {{ practicalInfo(site) }}
  </div>
</section>
