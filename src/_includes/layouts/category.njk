---
layout: layouts/base.njk
---
{#- Problem-led category page (BRIEF §6): intro, treatments, what to expect,
    from-price, FAQs, related before/afters, CTA. -#}
{% from "components/breadcrumbs.njk" import breadcrumbs %}
{% from "components/cta-band.njk" import ctaBand %}
{% from "components/fee-table.njk" import fromPrice %}
{% from "components/faq.njk" import faq %}
{% from "components/before-after.njk" import beforeAfter %}
{% from "components/button.njk" import button %}
<div class="container">
  {{ breadcrumbs(page.url | crumbs(collections.all)) }}
  <header class="page-head">
    {%- if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1>{{ heading or title }}</h1>
    {%- if lede %}<p class="page-head__lede">{{ lede }}</p>{% endif %}
    <div class="page-head__actions">
      {{ button("Request a callback", "/contact/#callback", "solid") }}
      <a class="button button--outline" href="{{ site.phone | telHref }}" data-event="phone_click">Call {{ site.phone | tbc | safe }}</a>
    </div>
  </header>
</div>

<div class="container section--tight">
  <div class="split">
    <div class="prose">
      {{ content | safe }}
    </div>
    <aside class="category-aside" aria-label="Price guide">
      {%- if price %}{{ fromPrice(price.label, price.from) }}{% endif %}
      <p class="small muted">You'll get a written treatment plan and estimate before any treatment starts.</p>
    </aside>
  </div>
</div>

{%- set cases = collections.gallery | byCategory(galleryCategory) %}
{%- if galleryCategory and cases.length %}
<section class="section section--paper" aria-labelledby="cases-heading">
  <div class="container">
    <div class="section__head section__head--split">
      <h2 id="cases-heading">Real results</h2>
      <a href="/smile-gallery/">See the smile gallery</a>
    </div>
    <div class="grid grid--3">
      {%- for c in cases | head(3) %}{{ beforeAfter(c) }}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if faqs and faqs.length %}
<div class="container container--narrow section">
  {{ faq(faqs) }}
</div>
{%- endif %}

{{ ctaBand(site) }}
